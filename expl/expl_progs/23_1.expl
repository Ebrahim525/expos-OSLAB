int main()
{
    decl
        int temp;
        string fileName, permission, w;
    enddecl

    begin
        w = "File Name";
        temp = exposcall("Write", -2, w);
        temp = exposcall("Read", -1, fileName);

        w = "Permission";
        temp = exposcall("Write", -2, w);
        temp = exposcall("Read", -1, permission);

        temp = exposcall("Create", fileName, permission);
        if(temp == -1) then
            w = "Error";
            temp = exposcall("Write", -2, w);
        else
            w = "File created";
            temp = exposcall("Write", -2, w);
        endif;

        return 0;
    end
}