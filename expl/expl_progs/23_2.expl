int main()
{
    decl
        int temp, temp2, permission;
        string fileName, w;
    enddecl

    begin
        w = "File Name";
        temp = exposcall("Write", -2, w);
        temp = exposcall("Read", -1, fileName);

        temp2 = exposcall("Delete", fileName);
        if(temp2 != 0) then
            w = "Error";
            temp = exposcall("Write", -2, w);
            temp = exposcall("Write", -2, temp2);
        else
            w = "File deleted";
            temp = exposcall("Write", -2, w);
        endif;

        return 0;
    end
}