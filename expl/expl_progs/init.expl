int main()
{
    decl
        int temp, temp2;
        string userName, password, w;
    enddecl
    begin
        while(1 == 1) do
            w = "Username";
            write(w);
            read(userName);
            w = "Password";
            write(w);
            read(password);

            temp = exposcall("Login", userName, password);
            if(temp == -1) then
                temp2 = exposcall("Write", -2, "Invalid Credentials");
            else
                if(temp == -2) then
                    temp2 = exposcall("Write", -2, "Permission Denied");
                endif;
            endif;
        endwhile;

        return 0;
    end
}