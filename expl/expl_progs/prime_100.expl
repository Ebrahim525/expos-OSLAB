decl
    int isPrime(int num);
enddecl

int isPrime(int num)
{
    decl
        int i;
    enddecl
    begin
        i = 2;
        while(i < num) do
            if(num%i == 0) then
                return 0;
            endif;

            i = i + 1;
        endwhile;

        return 1;
    end
}
int main()
{
    decl
        int temp, num;
    enddecl
    begin
        num = 2;
        while(num < 100) do
            temp = isPrime(num);
            if(temp == 1) then
                exposcall("Write", -2, num);
            endif;

            num = num + 1;
        endwhile;
        return 0;
    end;
}