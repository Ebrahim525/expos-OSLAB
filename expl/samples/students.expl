type
	Student {
		str name;
		int marks;
	}
endtype

int main()
{
	decl
		int temp;
		Student x1;
	enddecl
	begin
		breakpoint;
		temp = exposcall ("Heapset");

		breakpoint;
		x1 = exposcall ("Alloc",  20);
		breakpoint;
		
		x1.name = "John";
		x1.marks = 89;

		breakpoint;
		temp = exposcall ( "Write", -2, x1.name);
		temp = exposcall ( "Write", -2, x1.marks);
		
		breakpoint;
		temp = exposcall ("Free", x1);
		
		breakpoint;
		return 0;
	end
}
