R1 = ACQUIRE_KERN_LOCK;
call MOD_8;

alias currentPID R15;
currentPID = [SYSTEM_STATUS_TABLE + CORE*5 + 1];

//MODE Flag
[PROCESS_TABLE + currentPID * 16 + 9] = 10;

// Switch to Kernel Stack
SP = [PROCESS_TABLE + currentPID * 16 + 11] * 512 - 1;

R1 = EXIT_PROCESS;
R2 = currentPID;
call MOD_1;

R1 = RELEASE_LOCK;
R2 = KERN_LOCK;
call MOD_8;

call MOD_5;