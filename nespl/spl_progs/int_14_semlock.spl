R1 = ACQUIRE_KERN_LOCK;
call MOD_8;


alias userSP R1;
userSP = SP;

alias currentPID R15;
currentPID = [SYSTEM_STATUS_TABLE + CORE*5 + 1];

[PROCESS_TABLE + currentPID * 16 + 13] = SP;
SP = [PROCESS_TABLE + currentPID * 16 + 11] * 512 - 1;

alias systemCall R2;
systemCall = [[PTBR + 2 * (userSP-5) / 512] * 512 + (userSP-5) % 512];

[PROCESS_TABLE + currentPID * 16 + 9] = systemCall;

alias retValAddr R3;
retValAddr = [PTBR + 2 * (userSP-1) / 512] * 512 + (userSP-1) % 512;

alias perProcessTable R4;
perProcessTable = (([PROCESS_TABLE + currentPID * 16 + 11] + 1) * 512) - 16;


if(systemCall == INT_SEMLOCK) then
    alias semID R5;
    semID = [[PTBR + 2 * (userSP-4) / 512] * 512 + (userSP-4) % 512];

    if(semID < 0 || semID >= 8) then
        [retValAddr] = -1;
        [PROCESS_TABLE + currentPID * 16 + 9] = 0;
        SP = userSP;
        ireturn;
    endif;

    if([perProcessTable + semID * 2 + 0] != SEMAPHORE) then
        [retValAddr] = -1;
        [PROCESS_TABLE + currentPID * 16 + 9] = 0;
        SP = userSP;

        ireturn;
    endif;

    alias semDesc R6;
    semDesc = [perProcessTable + semID * 2 + 1];

    while([SEMAPHORE_TABLE + semDesc * 4 + 0] != -1) do
        [PROCESS_TABLE + currentPID * 16 + 4] = WAIT_SEMAPHORE;
        [PROCESS_TABLE + currentPID * 16 + 5] = semDesc;

        multipush(R1, R2, R3, R4, R5, R6, R15);
        R1 = RELEASE_LOCK;
        R2 = KERN_LOCK;
        call MOD_8;

        call MOD_5;
        
        multipop(R1, R2, R3, R4, R5, R6, R15);
    endwhile;

    [SEMAPHORE_TABLE + semDesc * 4 + 0] = currentPID;

    [retValAddr] = 0;

endif;

if(systemCall == INT_SEMUNLOCK) then
    alias semID R5;
    semID = [[PTBR + 2 * (userSP-4) / 512] * 512 + (userSP-4) % 512];

    if(semID < 0 || semID >= 8) then
        [retValAddr] = -1;
        [PROCESS_TABLE + currentPID * 16 + 9] = 0;
        SP = userSP;
        ireturn;
    endif;

    if([perProcessTable + semID * 2 + 0] != SEMAPHORE) then
        [retValAddr] = -1;
        [PROCESS_TABLE + currentPID * 16 + 9] = 0;
        SP = userSP;

        ireturn;
    endif;

    alias semDesc R6;
    semDesc = [perProcessTable + semID * 2 + 1];

    if([SEMAPHORE_TABLE + semDesc * 4 + 0] != -1) then
        if([SEMAPHORE_TABLE + semDesc * 4 + 0] != currentPID) then
            [retValAddr] = -2;
            [PROCESS_TABLE + currentPID * 16 + 9] = 0;
            SP = userSP;

            ireturn;
        endif;

        [SEMAPHORE_TABLE + semDesc * 4 + 0] = -1;

        alias processLoop R7;
        processLoop = 0;
        while(processLoop < MAX_PROC_NUM) do
            if([PROCESS_TABLE + processLoop * 16 + 4] == WAIT_SEMAPHORE && [PROCESS_TABLE + processLoop * 16 + 5] == semDesc) then
                [PROCESS_TABLE + processLoop * 16 + 4] = READY;
            endif;

            processLoop = processLoop + 1;
        endwhile;
    endif;

    [retValAddr] = 0;
endif;


[PROCESS_TABLE + currentPID * 16 + 9] = 0;
SP = [PROCESS_TABLE + currentPID * 16 + 13];

R1 = RELEASE_LOCK;
R2 = KERN_LOCK;
call MOD_8;

ireturn;