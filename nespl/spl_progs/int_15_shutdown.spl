R1 = ACQUIRE_KERN_LOCK;
call MOD_8;

alias retValAddr R1;
retValAddr = [PTBR + 2 * (SP-1) / 512] * 512 + (SP-1) % 512;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + CORE * 5 +1] * 16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + CORE * 5 +1] * 16 + 11] * 512 - 1;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + CORE * 5 +1] * 16 + 9] = INT_SHUTDOWN;

if([SYSTEM_STATUS_TABLE + CORE * 5 +1] != SHELL_PROCESS && [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + CORE * 5 +1] * 16 + 3] != ROOT) then
    [retValAddr] = -1;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + CORE * 5 +1] * 16 + 9] = 0;
    SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + CORE * 5 +1] * 16 + 13];

    ireturn;
endif;

reset;
[SCHED_LOCK] = 0;

// Kill All
R1 = KILL_ALL;
R2 = [SYSTEM_STATUS_TABLE + CORE * 5 +1];
call MOD_1;

alias loop R2;
loop = 0;
while(loop < MAX_BUFFER) do
    breakpoint;
    if([BUFFER_TABLE + loop * 4 + 1] == 1 && [BUFFER_TABLE + loop * 4 + 0] != -1) then
        breakpoint;
        multipush(R1, R2, R3, R4, R5);

        R3 = BUFFER / 512 + loop;
        R4 = [BUFFER_TABLE + loop * 4 + 0];
        R1 = DISK_STORE;
        R2 = [SYSTEM_STATUS_TABLE + CORE * 5 +1];
        call MOD_4;

        multipop(R1, R2, R3, R4, R5);

        [BUFFER_TABLE + loop * 4 + 1] = 0;
    endif;
    
    loop = loop + 1;
endwhile;

//Inode
R1 = DISK_STORE;
R2 = [SYSTEM_STATUS_TABLE + CORE * 5 +1];
R3 = 59;
R4 = 3;
call MOD_4;
R1 = DISK_STORE;
R2 = [SYSTEM_STATUS_TABLE + CORE * 5 +1];
R3 = 60;
R4 = 4;
call MOD_4;

//Root
R1 = DISK_STORE;
R2 = [SYSTEM_STATUS_TABLE + CORE * 5 +1];
R3 = 62;
R4 = 5;
call MOD_4;

// Disk Free List
R1 = DISK_STORE;
R2 = [SYSTEM_STATUS_TABLE + CORE * 5 +1];
R3 = 61;
R4 = 2;
call MOD_4;

R1 = RELEASE_LOCK;
R2 = KERN_LOCK;
call MOD_8;


halt;