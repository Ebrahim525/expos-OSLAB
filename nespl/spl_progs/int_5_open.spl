alias userSP R1;
userSP = SP;

alias currentPID R11;
currentPID = [SYSTEM_STATUS_TABLE + 1];

[PROCESS_TABLE + currentPID * 16 + 13] = SP;
SP = [PROCESS_TABLE + currentPID * 16 + 11] * 512 - 1;

alias systemCall R2;
systemCall = [[PTBR + 2 * (userSP-5) / 512] * 512 + (userSP-5) % 512];

[PROCESS_TABLE + currentPID * 16 + 9] = systemCall;

alias retValAddr R3;
retValAddr = [PTBR + 2 * (userSP-1) / 512] * 512 + (userSP-1) % 512;

alias file R4;
file = [[PTBR + 2 * (userSP-4) / 512] * 512 + (userSP-4) % 512];

alias perProcessTable R5;
perProcessTable = (([PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] + 1) * 512) - 16;


if(systemCall == INT_OPEN) then
    // Per Process Table
    alias loop R6;
    loop = 0;
    while(loop < 8) do
        if([perProcessTable + loop * 2 + 0] == -1) then
            break;
        endif;

        loop = loop + 1;
    endwhile;
    if(loop == 8) then
        [retValAddr] = -3;
        [PROCESS_TABLE + currentPID * 16 + 9] = 0;
        SP = [PROCESS_TABLE + currentPID * 16 + 13];
        
        ireturn;
    endif;

    multipush(R1, R2, R3, R4, R5, R6, R11);

    R1 = OPEN;
    R2 = file;
    call MOD_3;

    multipop(R1, R2, R3, R4, R5, R6, R11);

    if(R0 < 0) then
        [PROCESS_TABLE + currentPID * 16 + 9] = 0;
        SP = [PROCESS_TABLE + currentPID * 16 + 13];
        [retValAddr] = R0;

        ireturn;
    endif;

    [perProcessTable + loop * 2 + 0] = FILE;
    [perProcessTable + loop * 2 + 1] = R0;

    [retValAddr] = loop;
endif;

if(systemCall == INT_CLOSE) then
    if(file < 0 || file >= 8) then
        [retValAddr] = -1;
        [PROCESS_TABLE + currentPID * 16 + 9] = 0;
        SP = [PROCESS_TABLE + currentPID * 16 + 13];

        ireturn;
    endif;

    if([perProcessTable + file * 2 + 0] != FILE) then
        [retValAddr] = -1;
        [PROCESS_TABLE + currentPID * 16 + 9] = 0;
        SP = [PROCESS_TABLE + currentPID * 16 + 13];

        ireturn;
    endif;

    multipush(R1, R2, R3, R4, R5, R11);

    R1 = CLOSE;
    R2 = [perProcessTable + file * 2 + 1];
    call MOD_3;

    multipop(R1, R2, R3, R4, R5, R11);

    [perProcessTable + file * 2 + 0] = -1;

    [retValAddr] = 0;
endif;

if(systemCall == INT_SEEK) then
    alias offset R6;
    offset = [[PTBR + 2 * (userSP-3) / 512] * 512 + (userSP-3) % 512];

    if(file < 0 || file >= 8 || [perProcessTable + file * 2 + 0] != FILE) then
        [retValAddr] = -1;
        SP = userSP;
        [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

        ireturn;
    endif;

    alias openTableEntry R7;
    openTableEntry = OPEN_FILE_TABLE + [perProcessTable + file * 2 + 1] * 4;
    alias inodeTableEntry R8;
	inodeTableEntry = [openTableEntry + 0];

    multipush(R1, R2, R3, R4, R5, R6, R7, R8, R11);

    R1 = ACQUIRE_INODE;
    R2 = currentPID;
    R3 = [openTableEntry + 0];
    call MOD_0;

    multipop(R1, R2, R3, R4, R5, R6, R7, R8, R11);
    if(R0 != 0) then
        [retValAddr] = -1;
        SP = userSP;
        [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

        ireturn;
    endif;
    
    alias Lseek R9;
    Lseek = [openTableEntry + 2];
    alias fileSize R10;
    if(inodeTableEntry == INODE_ROOT) then
        fileSize = 480;
    else
        fileSize = [INODE_TABLE + inodeTableEntry * 16 + 2];
    endif;

    if(Lseek + offset < 0) then
        multipush(R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11);

		R1 = RELEASE_INODE;
		R2 = currentPID;
		R3 = inodeTableEntry;
		call MOD_0;

		multipop(R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11);

        [retValAddr] = -2;
        SP = userSP;
        [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

        ireturn;
    endif;
    
    if(offset == 0) then
        [openTableEntry + 2] = 0;
    else
        if(Lseek + offset > fileSize) then
            [openTableEntry + 2] = fileSize;
        else
            [openTableEntry + 2] = Lseek + offset;
        endif;
    endif;

    multipush(R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11);

		R1 = RELEASE_INODE;
		R2 = currentPID;
		R3 = inodeTableEntry;
		call MOD_0;

	multipop(R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11);
    
    [retValAddr] = 0;
endif;


[PROCESS_TABLE + currentPID * 16 + 9] = 0;
SP = userSP;

ireturn;