alias userSP R1;
userSP = SP;
alias currentPID R12;
currentPID = [SYSTEM_STATUS_TABLE + 1];

[PROCESS_TABLE + currentPID * 16 + 13] = userSP;
SP = [PROCESS_TABLE + currentPID * 16 + 11] * 512 - 1;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 7;

alias retValAddr R2;
retValAddr = [PTBR + 2 * ((userSP-1) / 512)] * 512 + (userSP-1) % 512;

alias fileDescriptor R3;
fileDescriptor = [[PTBR + 2 * ((userSP-4) / 512)] * 512 + (userSP-4) % 512];

alias word R4;
word = [[PTBR + 2 * ((userSP - 3) / 512)] * 512 + ((userSP - 3) % 512)];

alias perProcessTable R5;
perProcessTable = (([PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] + 1) * 512) - 16;

if(fileDescriptor == -1) then
    multipush(R1, R2, R3, R4, R5);

	R1 = TERMINAL_READ;
	R2 = [SYSTEM_STATUS_TABLE + 1];
	R3 = word;
    call MOD_4;

    multipop(R1, R2, R3, R4, R5);
    [retValAddr] = 0;
else
    if(fileDescriptor < 0 || fileDescriptor >= 8 || [perProcessTable + fileDescriptor * 2 + 0] != FILE) then
        [retValAddr] = -1;
        SP = userSP;
        [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

        ireturn;
    endif;

    alias openTableEntry R6;
    openTableEntry = OPEN_FILE_TABLE + [perProcessTable + fileDescriptor * 2 + 1] * 4 ;

    multipush(R1, R2, R3, R4, R5, R6);

    R1 = ACQUIRE_INODE;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    R3 = [openTableEntry + 0];
    call MOD_0;

    multipop(R1, R2, R3, R4, R5, R6);
    if(R0 != 0) then
        [retValAddr] = -1;
        SP = userSP;
        [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

        ireturn;
    endif;

    alias Lseek R7;
    Lseek = [openTableEntry + 2];
    if([openTableEntry + 0] == INODE_ROOT) then
        if(Lseek == 480) then
            multipush(R1, R2, R6);

            R1 = RELEASE_INODE;
            R2 = [SYSTEM_STATUS_TABLE + 1];
            R3 = [openTableEntry + 0];
            call MOD_0;

            multipop(R1, R2, R6);

            [retValAddr] = -2;
            SP = [PROCESS_TABLE + currentPID * 16 + 13];
            [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

            ireturn;
        endif;
        [([PTBR + 2 * (word / 512)] * 512) + (word % 512)] = [ROOT_FILE + Lseek];
        [openTableEntry + 2] = Lseek + 1;
    else
        if(Lseek == [INODE_TABLE + [openTableEntry + 0] * 16 + 2]) then
            multipush(R1, R2, R6);

            R1 = RELEASE_INODE;
            R2 = [SYSTEM_STATUS_TABLE + 1];
            R3 = [openTableEntry + 0];
            call MOD_0;

            multipop(R1, R2, R6);

            [retValAddr] = -2;
            SP = userSP;
            [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

            ireturn;
        endif;

        alias diskBlock R8;
        diskBlock = [INODE_TABLE + [openTableEntry + 0] * 16 + 8 + Lseek / 512];
        alias offset R9;
        offset = Lseek % 512;

        multipush(R1, R2, R3, R4, R5, R6, R7, R8, R9);

        R1 = BUFFERED_READ;
        R2 = diskBlock;
        R3 = offset;
        R4 = word;
        call MOD_3;

        multipop(R1, R2, R3, R4, R5, R6, R7, R8, R9);


        [openTableEntry + 2] = Lseek + 1;
    endif;

    multipush(R1, R2, R6);

    R1 = RELEASE_INODE;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    R3 = [openTableEntry + 0];
    call MOD_0;

    multipop(R1, R2, R6);
endif;

[retValAddr] = 0;

SP = userSP;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

ireturn;