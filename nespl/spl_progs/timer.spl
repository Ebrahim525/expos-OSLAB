//Saving user Stack Pointer
[PROCESS_TABLE + ( [SYSTEM_STATUS_TABLE + 1] * 16) + 13] = SP;

//Kernel Stack Pointer
SP = [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 11] * 512 - 1;

//Backing Registers
backup;



if([SYSTEM_STATUS_TABLE + 5] != 0) then
    if(CORE == 0) then
        R1 = ACQUIRE_KERN_LOCK;
        call MOD_8;

        if([SYSTEM_STATUS_TABLE + 1] == SWAPPER_DAEMON) then
            if([SYSTEM_STATUS_TABLE + 5] == SWAP_OUT) then
                R1 = SWAP_OUT;
                call MOD_6;
            else
                R1 = SWAP_IN;
                call MOD_6;
            endif;
        endif;

        R1 = RELEASE_LOCK;
        R2 = KERN_LOCK;
        call MOD_8;
    endif;
else
    if([SYSTEM_STATUS_TABLE + 2] < MEM_LOW) then
        [SYSTEM_STATUS_TABLE + 5] = SWAP_OUT;
    else
        if([SYSTEM_STATUS_TABLE + 4] > 0) then
            if([SYSTEM_STATUS_TABLE + 2] > MEM_HIGH) then
                [SYSTEM_STATUS_TABLE + 5] = SWAP_IN;
            else
                alias loop R0;
                loop = 3;
                while(loop < MAX_PROC_NUM - 1) do
                    if([PROCESS_TABLE + loop * 16 + 6] == 1 && [PROCESS_TABLE + loop * 16 + 4] != TERMINATED && [PROCESS_TABLE + loop * 16 + 0] > MAX_TICK) then
                        [SYSTEM_STATUS_TABLE + 5] = SWAP_IN;
                        break;
                    endif;

                    loop = loop + 1;
                endwhile;
            endif;
        endif;
    endif;
endif;
    


// currentPID
alias currentPID R0;
currentPID = [SYSTEM_STATUS_TABLE + 1];

// Changing to ready state
alias process_table_entry R1;
process_table_entry = PROCESS_TABLE + currentPID * 16;
[process_table_entry + 4] = READY;

// Incrementing Tick
alias processLoop R0;
processLoop = 0;
while( processLoop < MAX_PROC_NUM ) do
    if( [PROCESS_TABLE + processLoop*16 + 4] != TERMINATED) then
        [PROCESS_TABLE + processLoop*16 + 0] = [PROCESS_TABLE + processLoop*16 + 0] + 1;
    endif ;

    processLoop = processLoop + 1;
endwhile;

// Scheduler Module
call MOD_5;

// Restoring Registers
restore;

// Setting SP to User Stack Pointer
SP = [PROCESS_TABLE + ( [SYSTEM_STATUS_TABLE + 1] * 16) + 13];

// MODE FLAG
[PROCESS_TABLE + ( [SYSTEM_STATUS_TABLE + 1] * 16) + 9] = 0;

ireturn;