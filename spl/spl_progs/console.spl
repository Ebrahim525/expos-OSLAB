//Saving SP in Process Table and setting SP to Kernel Stack
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

backup;

alias reqPID R0;
reqPID = [TERMINAL_STATUS_TABLE + 1];

[PROCESS_TABLE + reqPID * 16 + 8] = P0;
R1 = [PROCESS_TABLE + reqPID * 16 + 8];


//Release terminal
multipush(R0);
R1 = RELEASE_TERMINAL;
R2 = reqPID;
call MOD_0;
multipop(R0);

restore;

// Setting SP to User Stack Pointer
SP = [PROCESS_TABLE + ( [SYSTEM_STATUS_TABLE + 1] * 16) + 13];

ireturn;