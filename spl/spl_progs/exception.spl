
//MODE Flag
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = -1;

//Saving user Stack Pointer
[PROCESS_TABLE + ( [SYSTEM_STATUS_TABLE + 1] * 16) + 13] = SP;

alias userSP R0;
userSP = SP;

//Kernel Stack Pointer
SP = [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 11] * 512 - 1;

backup;

multipush(EIP);

if(EC != 0 || userSP == PTLR * 512 - 1) then
    if(EC == 1) then
        print("Illegal Instruction");
    endif;

    if(EC == 2) then
        print("Illegal Memory Access");
    endif;

    if(EC == 3) then
        print("Arithmetic Exception");
    endif;

    // Exit Process
    R1 = EXIT_PROCESS;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    call MOD_1;

    call MOD_5;
endif;

alias currentPID R1;
currentPID = [SYSTEM_STATUS_TABLE + 1];

if(EPN > 3 && EPN < 8) then
    alias codeBlock R2;
    codeBlock = [DISK_MAP_TABLE + currentPID * 10 + EPN];

    multipush(R0, R1, R2);

        R1 = GET_CODE_PAGE;
        R2 = currentPID;
        R3 = codeBlock;
        call MOD_2;

        [PTBR + EPN] = R0; // Memory Page
        [PTBR + EPN + 1] = "1100"; // Why 1

    multipop(R0, R1, R2);
endif;

if(EPN > 1 && EPN < 4) then
    multipush(R0, R1);

        alias loop R3;
        loop = 4;
        while(loop < 8) do
            R1 = GET_FREE_PAGE;
            R2 = currentPID;
            call MOD_2;
            [PTBR + loop] = R0;
            [PTBR + loop + 1] = "1110";

            loop = loop + 2;
        endwhile;

    multipop(R0, R1);
endif;

//MODE Flag
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

multipop(EIP);

restore;

SP = [PROCESS_TABLE + ( [SYSTEM_STATUS_TABLE + 1] * 16) + 13];

SP = SP + 1;
[[PTBR + 2*(SP / 512)] * 512 + SP % 512] = EIP;

ireturn;