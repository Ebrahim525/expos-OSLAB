alias userSP R0;
userSP = SP;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

alias systemCall R1;
systemCall = [[PTBR + 2 * (userSP-5) / 512] * 512 + (userSP-5) % 512];

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = systemCall;

alias retValAddr R2;
retValAddr = [PTBR + 2 * (userSP-1) / 512] * 512 + (userSP-1) % 512;


if(systemCall == INT_WAIT) then
    alias PID R3;
    PID = [[PTBR + 2 * (userSP-4) / 512] * 512 + (userSP-4) % 512];

    if(PID == [SYSTEM_STATUS_TABLE + 1] || [PROCESS_TABLE + PID * 16 + 4] == TERMINATED || PID < 0 || PID >= MAX_PROC_NUM) then
        [retValAddr] = -1;
        [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
        SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];

        ireturn;
    endif;

    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 4] = WAIT_PROCESS;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 5] = PID;

    call MOD_5;

    [retValAddr] = 0;
endif;

if(systemCall == INT_SIGNAL) then
    alias processLoop R3;
    processLoop = 0;
    while(processLoop < MAX_PROC_NUM) do
        if([PROCESS_TABLE + processLoop * 16 + 4] == WAIT_PROCESS && [PROCESS_TABLE + processLoop * 16 + 5] == [SYSTEM_STATUS_TABLE + 1]) then
            [PROCESS_TABLE + processLoop * 16 + 4] = READY;
        endif;

        processLoop = processLoop + 1;
    endwhile;

    [retValAddr] = 0;
endif;

if(systemCall == INT_GETPID) then
    [retValAddr] = [SYSTEM_STATUS_TABLE + 1];
endif;

if(systemCall == INT_GETPPID) then
    [retValAddr] = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 2];
endif;


[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];


ireturn;