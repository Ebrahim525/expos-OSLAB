alias userSP R1;
userSP = SP;
alias currentPID R2;
currentPID = [SYSTEM_STATUS_TABLE + 1];

[PROCESS_TABLE + currentPID * 16 + 13] = userSP;
SP = [PROCESS_TABLE + currentPID * 16 + 11] * 512 - 1;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 28;

alias retValAddr R3;
retValAddr = [PTBR + 2 * ((userSP-1) / 512)] * 512 + (userSP-1) % 512;


if(currentPID != 2) then
    [retValAddr] = -1;
    SP = userSP;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

    ireturn;
endif;

multipush(R1, R2, R3);

R1 = KILL_ALL;
R2 = currentPID;
call MOD_1;

multipop(R1, R2, R3);

[PROCESS_TABLE + 2 * 16 + 4] = TERMINATED;

alias newIP R4;
newIP = [PTBR + 40 + 2 * 8] * 512 + 2;

userSP = userSP + 1;
[userSp] = newIP;
[PROCESS_TABLE + currentPID * 16 + 13] = userSP;


[PROCESS_TABLE + 1 * 16 + 4] = READY;

[SYSTEM_STATUS_TABLE + 0] = 0;

multipush(R1, R2, R3, R4);

call MOD_5;

multipop(R1, R2, R3, R4);


SP = userSP;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

ireturn;