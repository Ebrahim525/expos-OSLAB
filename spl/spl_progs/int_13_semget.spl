alias userSP R1;
userSP = SP;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

alias systemCall R2;
systemCall = [[PTBR + 2 * (userSP-5) / 512] * 512 + (userSP-5) % 512];

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = systemCall;

alias retValAddr R3;
retValAddr = [PTBR + 2 * (userSP-1) / 512] * 512 + (userSP-1) % 512;

alias perProcessTable R4;
perProcessTable = (([PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] + 1) * 512) - 16;


if(systemCall == INT_SEMGET) then
    // Per Process Table
    alias loop R5;
    loop = 0;
    while(loop < 8) do
        if([perProcessTable + loop * 2 + 0] == -1) then
            break;
        endif;

        loop = loop + 1;
    endwhile;
    if(loop == 8) then
        [retValAddr] = -1;
        
        ireturn;
    endif;

    multipush(R1, R2, R3, R4, R5);
    
    R1 = ACQUIRE_SEMAPHORE;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    call MOD_0;

    multipop(R1, R2, R3, R4, R5);

    if(R0 == -1) then
        [retValAddr] = -2;

        ireturn;
    endif;

    [perProcessTable + loop * 2 + 0] = SEMAPHORE;
    [perProcessTable + loop * 2 + 1] = R0;

    [retValAddr] = loop;

endif;

if(systemCall == INT_SEMRELEASE) then
    alias semID R5;
    semID = [[PTBR + 2 * (userSP-4) / 512] * 512 + (userSP-4) % 512];

    if(semID < 0 || semID >= 8) then
        [retValAddr] = -1;

        ireturn;
    endif;

    if([perProcessTable + semID * 2 + 0] != SEMAPHORE) then
        [retValAddr] = -1;

        ireturn;
    endif;
    
    multipush(R1, R2, R3, R4, R5, R6);
    
    R1 = RELEASE_SEMAPHORE;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    R3 = [perProcessTable + semID * 2 + 1];
    call MOD_0;
    
    multipop(R1, R2, R3, R4, R5, R6);

    [perProcessTable + semID * 2 + 0] = -1;

    [retValAddr] = 0;
    
endif;


[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];


ireturn;