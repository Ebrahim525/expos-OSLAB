alias userSP R1;
userSP = SP;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

alias systemCall R2;
systemCall = [[PTBR + 2 * (userSP-5) / 512] * 512 + (userSP-5) % 512];

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = systemCall;

alias retValAddr R3;
retValAddr = [PTBR + 2 * (userSP-1) / 512] * 512 + (userSP-1) % 512;


if(systemCall == INT_SEMGET) then
    alias perProcessTable R4;
    perProcessTable = (([PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] + 1) * 512) - 16;

    // Per Process Table
    alias loop R5;
    loop = 0;
    while(loop < 16) do
        if([perProcessTable + loop] == -1) then
            break;
        endif;

        loop = loop + 2;
    endwhile;
    if(loop == 16) then
        [retValAddr] = -1;
        
        ireturn;
    endif;

    [perProcessTable + loop + 0] = SEMAPHORE;

    multipush(R1, R2, R3, R4, R5);
    
    R1 = ACQUIRE_SEMAPHORE;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    call MOD_1;

    multipop(R1, R2, R3, R4, R5);

    if(R0 == -1) then
        [retValAddr] = -2;

        ireturn;
    endif;

    [perProcessTable + loop + 1] = R0;

endif;

if(systemCall == INT_SEMRELEASE) then
    alias semDesc R4;
    semDesc = [[PTBR + 2 * (userSP-4) / 512] * 512 + (userSP-4) % 512];

    if(semDesc < 0 || semDesc > 8) then
        [retValAddr] = -1;

        ireturn;
    endif;

    alias loop R5;
    loop = 0;
    while(loop < 16) do
        if([perProcessTable + loop + 1] == semDesc) then
            break;
        endif;

        loop = loop + 2;
    endwhile;
    if(loop == 16) then
        [retValAddr] = -1;

        ireturn;
    endif;

    multipush(R1, R2, R3, R4, R5);
    
    R1 = RELEASE_SEMAPHORE;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    R3 = semDesc;
    call MOD_1;

    multipop(R1, R2, R3, R4, R5);

    [perProcessTable + loop + 0] = -1;

    [retValAddr] = 0;
endif;


[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];


ireturn;