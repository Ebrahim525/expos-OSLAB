alias retValAddr R1;
retValAddr = [PTBR + 2 * (SP-1) / 512] * 512 + (SP-1) % 512;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = INT_SHUTDOWN;

if([SYSTEM_STATUS_TABLE + 1] != 1 && [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 3] != ROOT) then
    [retValAddr] = -1;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
    SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];

    ireturn;
endif;

// Kill All
R1 = KILL_ALL;
R2 = [SYSTEM_STATUS_TABLE + 1];
call MOD_1;

alias loop R2;
loop = 0;
while(loop < MAX_BUFFER) do
    if([BUFFER_TABLE + loop * 4 + 1] == 1) then
        multipush(R1, R2, R3, R4, R5);

        R1 = DISK_STORE;
        R2 = [SYSTEM_STATUS_TABLE + 1];
        R3 = BUFFER / 512 + loop;
        R4 = [BUFFER_TABLE + loop * 4 + 0];
        call MOD_4;

        multipop(R1, R2, R3, R4, R5);

        [BUFFER_TABLE + loop * 4 + 1] = 0;
    endif;
    
    loop = loop + 1;
endwhile;

//Inode
R1 = DISK_STORE;
R2 = [SYSTEM_STATUS_TABLE + 1];
R3 = 59;
R4 = 3;
call MOD_4;
R1 = DISK_STORE;
R2 = [SYSTEM_STATUS_TABLE + 1];
R3 = 60;
R4 = 4;
call MOD_4;

//Root
R1 = DISK_STORE;
R2 = [SYSTEM_STATUS_TABLE + 1];
R3 = 62;
R4 = 5;
call MOD_4;

// Disk Free List
R1 = DISK_STORE;
R2 = [SYSTEM_STATUS_TABLE + 1];
R3 = 61;
R4 = 2;
call MOD_4;

halt;