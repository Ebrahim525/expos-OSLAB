alias userSP R1;
userSP = SP;
alias currentPID R2;
currentPID = [SYSTEM_STATUS_TABLE + 1];

[PROCESS_TABLE + currentPID * 16 + 13] = userSP;
SP = [PROCESS_TABLE + currentPID * 16 + 11] * 512 - 1;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 27;

alias retValAddr R3;
retValAddr = [PTBR + 2 * ((userSP-1) / 512)] * 512 + (userSP-1) % 512;

alias userName R4;
userName = [[PTBR + 2 * ((userSP-4) / 512)] * 512 + (userSP-4) % 512];

alias password R5;
password = [[PTBR + 2 * ((userSP - 3) / 512)] * 512 + ((userSP - 3) % 512)];


if(currentPID != 0) then
    [retValAddr] = -2;
    SP = userSP;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

    ireturn;
endif;

alias userEntry R6;
userEntry = 0;
while(userEntry < MAX_USER_NUM) do
    if([USER_TABLE + userEntry * 16 + 0] == userName) then
        break;
    endif;

    userEntry = userEntry + 1;
endwhile;
if(userEntry == MAX_USER_NUM) then
    [retValAddr] = -1;
    SP = userSP;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

    ireturn;
endif;

encrypt password;

if([USER_TABLE + userEntry * 2 + 1] != password) then
    [retValAddr] = -1;
    SP = userSP;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

    ireturn;
endif;

// Shell
[PROCESS_TABLE + 2 * 16 + 3] = userEntry;
[PROCESS_TABLE + 2 * 16 + 4] = CREATED;

[PROCESS_TABLE + 1 * 16 + 4] = WAIT_PROCESS;
[PROCESS_TABLE + 1 * 16 + 5] = 2;

[SYSTEM_STATUS_TABLE + 0] = 2;

multipush(R1, R2, R3, R4, R5, R6);

call MOD_5;

multipop(R1, R2, R3, R4, R5, R6);


SP = userSP;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

ireturn;