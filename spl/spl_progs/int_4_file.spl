alias userSP R1;
userSP = SP;

alias currentPID R8;
currentPID = [SYSTEM_STATUS_TABLE + 1];

[PROCESS_TABLE + currentPID * 16 + 13] = SP;
SP = [PROCESS_TABLE + currentPID * 16 + 11] * 512 - 1;

alias systemCall R2;
systemCall = [[PTBR + 2 * (userSP-5) / 512] * 512 + (userSP-5) % 512];

[PROCESS_TABLE + currentPID * 16 + 9] = systemCall;

alias retValAddr R3;
retValAddr = [PTBR + 2 * (userSP-1) / 512] * 512 + (userSP-1) % 512;

alias fileName R4;
fileName = [[PTBR + 2 * (userSP-4) / 512] * 512 + (userSP-4) % 512];


if(systemCall == INT_CREATE) then
    alias permission R5;
    permission = [[PTBR + 2 * (userSP-3) / 512] * 512 + (userSP-3) % 512];

    alias inodeLoop R6;
    inodeLoop = 0;
    while(inodeLoop < MAX_FILE_NUM) do
        if([INODE_TABLE + inodeLoop * 16 + 1] == fileName) then
            [retValAddr] = 0;
            [PROCESS_TABLE + currentPID * 16 + 9] = 0;
            SP = [PROCESS_TABLE + currentPID * 16 + 13];

            ireturn;
        endif;

        inodeLoop = inodeLoop + 1;
    endwhile;

    alias freeEntry R7;
    inodeLoop = 0;
    while(inodeLoop < MAX_FILE_NUM) do
        if([INODE_TABLE + inodeLoop * 16 + 1] == -1) then
            freeEntry = inodeLoop;
            break;
        endif;

        inodeLoop = inodeLoop + 1;
    endwhile;
    if(inodeLoop == MAX_FILE_NUM) then
        [retValAddr] = -1;
        [PROCESS_TABLE + currentPID * 16 + 9] = 0;
        SP = [PROCESS_TABLE + currentPID * 16 + 13];

        ireturn;
    endif;

    // Inode Table Entry
    alias inodeEntry R9;
    inodeEntry = INODE_TABLE + freeEntry * 16;
    [inodeEntry + 0] = DATA;
    [inodeEntry + 1] = fileName;
    [inodeEntry + 2] = 0;
    [inodeEntry + 3] = [SYSTEM_STATUS_TABLE + 0];
    [inodeEntry + 4] = permission;
    [inodeEntry + 8] = -1;
    [inodeEntry + 9] = -1;
    [inodeEntry + 10] = -1;
    [inodeEntry + 11] = -1;


    // Root File Entry
    alias rootEntry R9;
    rootEntry = ROOT_FILE + freeEntry * 8;
    [rootEntry + 0] = fileName;
    [rootEntry + 1] = 0;
    [rootEntry + 2] = DATA;
    [rootEntry + 3] = [USER_TABLE + [SYSTEM_STATUS_TABLE + 0] * 2 + 0];
    [rootEntry + 4] = permission;

    [retValAddr] = 0;
endif;

if(systemCall == INT_DELETE) then
    alias inodeLoop R5;
    inodeLoop = 0;
    while(inodeLoop < MAX_FILE_NUM) do
        if([INODE_TABLE + inodeLoop * 16 + 1] == fileName) then
            break;
        endif;

        inodeLoop = inodeLoop + 1;
    endwhile;
    if(inodeLoop == MAX_FILE_NUM) then
        [retValAddr] = 0;
        [PROCESS_TABLE + currentPID * 16 + 9] = 0;
        SP = [PROCESS_TABLE + currentPID * 16 + 13];

        ireturn;
    endif;
    if([INODE_TABLE + inodeLoop * 16 + 0] != DATA) then    
        [retValAddr] = -1;
        [PROCESS_TABLE + currentPID * 16 + 9] = 0;
        SP = [PROCESS_TABLE + currentPID * 16 + 13];

        ireturn;
    endif;

    if([INODE_TABLE + inodeLoop * 16 + 4] == EXCLUSIVE && [INODE_TABLE + inodeLoop * 16 + 3] != [PROCESS_TABLE + currentPID * 16 + 3] && [PROCESS_TABLE + currentPID * 16 + 3] != ROOT) then
            [retValAddr] = -1;
            [PROCESS_TABLE + currentPID * 16 + 9] = 0;
            SP = [PROCESS_TABLE + currentPID * 16 + 13];

            ireturn;
    endif;

    multipush(R1, R2, R3, R4, R5, R8);

    R1 = ACQUIRE_INODE;
    R2 = currentPID;
    R3 = inodeLoop;
    call MOD_0;

    multipop(R1, R2, R3, R4, R5, R8);

    if([FILE_STATUS_TABLE + inodeLoop * 4 + 1] != -1) then
        multipush(R1, R2, R3, R4, R5, R8);

        R1 = RELEASE_INODE;
        R2 = currentPID;
        R3 = inodeLoop;
        call MOD_0;

        multipop(R1, R2, R3, R4, R5);

        [retValAddr] = -2;
        [PROCESS_TABLE + currentPID * 16 + 9] = 0;
        SP = [PROCESS_TABLE + currentPID * 16 + 13];
        
        ireturn;
    endif;

    alias diskLoop R6;
    diskLoop = 8;
    while(diskLoop < 12) do
        alias diskBlock R7;
        diskBlock = [INODE_TABLE + inodeLoop * 16 + diskLoop];
        if(diskBlock != -1) then
            if([BUFFER_TABLE + (diskBlock % MAX_BUFFER) * 4 + 0] == diskBlock) then
                [BUFFER_TABLE + (diskBlock % MAX_BUFFER) * 4 + 1] = 0; // Reset Dirty Bit
            endif;

            multipush(R1, R2, R3, R4, R5, R6, R7, R8);

            R1 = RELEASE_BLOCK;
            R2 = diskBlock;
            call MOD_2;

            multipop(R1, R2, R3, R4, R5, R6, R7, R8);
        endif;
        diskLoop = diskLoop + 1;
    endwhile;

    [INODE_TABLE + inodeLoop * 16 + 1] = -1; // Invalidate Inode Table Entry
    [ROOT_FILE + inodeLoop * 8 + 0] = -1; // Invalidate Root File Entry

    multipush(R1, R2, R3, R4, R5, R8);

    R1 = RELEASE_INODE;
    R2 = currentPID;
    R3 = inodeLoop;
    call MOD_0;

    multipop(R1, R2, R3, R4, R5, R8);

    [retValAddr] = 0;
endif;



[PROCESS_TABLE + currentPID * 16 + 9] = 0;
SP = [PROCESS_TABLE + currentPID * 16 + 13];


ireturn;