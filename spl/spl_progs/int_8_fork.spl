[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 8;

alias retValAddr R2;
retValAddr = [PTBR + 2 * (SP - 1)/512] * 512 + (SP - 1) % 512;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

// Getting PID for the child process
R1 = GET_PCB_ENTRY;
call MOD_1;

alias newPid R1;
newPid = R0;

[retValAddr] = newPid;

if(newPid == -1) then
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
    SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];
    [retValAddr] = -1;
    
    ireturn;
endif;


// If parent does'nt have heap allocated
if([PTBR + 4] == -1) then
    multipush(R1, R2);
        R1 = GET_FREE_PAGE;
        R2 = [SYSTEM_STATUS_TABLE + 1];
        call MOD_2;
        [PTBR + 4] = R0;
        [PTBR + 5] = "0110";

        R1 = GET_FREE_PAGE;
        R2 = [SYSTEM_STATUS_TABLE + 1];
        call MOD_2;
        [PTBR + 6] = R0;
        [PTBR + 7] = "0110";
    multipop(R1, R2);
endif;


// User Area Page for child
multipush(R1, R2);
        R1 = GET_FREE_PAGE;
        R2 = [SYSTEM_STATUS_TABLE + 1];
        call MOD_2;
multipop(R1, R2);
[PROCESS_TABLE + newPid * 16 + 11] = R0; // User Area Page


// Stack
multipush(R1, R2);
    R1 = GET_FREE_PAGE;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    call MOD_2;
multipop(R1, R2);
[PAGE_TABLE_BASE + newPid * 20 + 16] = R0;
[PAGE_TABLE_BASE + newPid * 20 + 17] = [PTBR + 17];

multipush(R1, R2);
    R1 = GET_FREE_PAGE;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    call MOD_2;
multipop(R1, R2);
[PAGE_TABLE_BASE + newPid * 20 + 18] = R0;
[PAGE_TABLE_BASE + newPid * 20 + 19] = [PTBR + 19];


[PROCESS_TABLE + newPid * 16 + 0] = 0; // TICK
[PROCESS_TABLE + newPid * 16 + 2] = [SYSTEM_STATUS_TABLE + 1]; // PPID
[PROCESS_TABLE + newPid * 16 + 3] = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 3]; // UserId
[PROCESS_TABLE + newPid * 16 + 4] = CREATED; // State
[PROCESS_TABLE + newPid * 16 + 6] = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 6]; // Swap Flag
[PROCESS_TABLE + newPid * 16 + 7] = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 7]; // Inode
[PROCESS_TABLE + newPid * 16 + 9] = 0; // Mode Flag
[PROCESS_TABLE + newPid * 16 + 10] = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 10]; // USER AREA SWAP STATUS
[PROCESS_TABLE + newPid * 16 + 12] = 0; // KPTR
[PROCESS_TABLE + newPid * 16 + 13] = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13]; // UPTR


// Per Process Table
alias parentUserArea R3;
alias childUserArea R4;
parentUserArea = (([PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] + 1) * 512) - 16;
childUserArea = (([PROCESS_TABLE + newPid * 16 + 11] + 1) * 512) -16;
alias loop R5;
loop = 0;
while(loop < 16) do
    [childUserArea + loop + 0] = [parentUserArea + loop + 0];
    [childUserArea + loop + 1] = [parentUserArea + loop + 1];
 
    if([parentUserArea + loop + 0] == SEMAPHORE) then
        alias processCountAddr R6;
        processCountAddr = SEMAPHORE_TABLE + [parentUserArea + loop + 1] * 4 + 1;
        [processCountAddr] = [processCountAddr] + 1;
    endif;

    loop = loop + 2;
endwhile;



// Disk Map Entry
alias diskLoop R3;
diskLoop = 0;
while(diskLoop < 10) do
    [DISK_MAP_TABLE + newPid * 10 + diskLoop] = [DISK_MAP_TABLE + [SYSTEM_STATUS_TABLE + 1] * 10 + diskLoop];

    diskLoop = diskLoop + 1;
endwhile;


// Page Table
alias loop R3;
loop = 0;
while(loop < 16) do
    [PAGE_TABLE_BASE + newPid * 20 + loop] = [PTBR + loop];
    [PAGE_TABLE_BASE + newPid * 20 + loop + 1] = [PTBR + loop + 1];
    [MEMORY_FREE_LIST + [PTBR + loop]] = [MEMORY_FREE_LIST + [PTBR + loop]] + 1;

    loop = loop + 2;
endwhile;


alias parentUserStack R4;
alias childUserStack R5;
parentUserStack = [PTBR + 16] * 512;
childUserStack = [PAGE_TABLE_BASE + newPid * 20 + 16] * 512;
loop = 0;
while(loop < 1024) do
    [childUserStack + loop] = [parentUserStack + loop];
    
    loop = loop + 1;
endwhile;


alias childKernalstack R4;
childKernalstack = [PROCESS_TABLE + newPid * 16 + 11] * 512 - 1;
SP = childKernalstack;
multipush(BP);


// Setting return value for child
alias newSP R4;
newSP = [PROCESS_TABLE + newPid * 16 + 13];
alias newPTBR R5;
newPTBR = PAGE_TABLE_BASE + newPid * 20;
retValAddr = [newPTBR + 2 * (newSP - 1)/512] * 512 + (newSP - 1) % 512;
[retValAddr] = 0;


SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

ireturn;