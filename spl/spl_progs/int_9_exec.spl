//MODE Flag
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 9;

//Save User SP
alias userSP R0;
userSP = SP;

//Saving SP in Process Table and setting SP to Kernel Stack
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

alias retValAddr R1;
retValAddr = [PTBR + 2 * (userSP - 1)/512] * 512 + ((userSP - 1) % 512);

alias fileName R2;
fileName = [[PTBR + 2 * (userSP - 4)/512] * 512 + ((userSP - 4) % 512)];

alias inodeEntry R3;
inodeEntry = 0;
while (inodeEntry < MAX_FILE_NUM) do
    if ([INODE_TABLE + inodeEntry * 16 + 1] == fileName) then
        if([INODE_TABLE + inodeEntry * 16 + 0] != EXEC) then
            [retValAddr] = -1;
            ireturn;
        endif;
        break;
    endif;

    inodeEntry = inodeEntry + 1;
endwhile;

if (inodeEntry == MAX_FILE_NUM) then
    [retValAddr] = -1;
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
    SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];
    ireturn;
endif;

multipush(R0, R1, R2, R3);

R1 = EXIT_PROCESS;
R2 = [SYSTEM_STATUS_TABLE + 1];
call MOD_1;

multipop(R0, R1, R2, R3);

alias userAreaPage R4;
userAreaPage = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11];

//Mem Free List entry
[MEMORY_FREE_LIST + userAreaPage] = [MEMORY_FREE_LIST + userAreaPage] + 1;

//Decrementing Mem Free Count
[SYSTEM_STATUS_TABLE + 2] = [SYSTEM_STATUS_TABLE + 2] - 1;


SP = userAreaPage * 512 - 1;

// Setting Per Process Table
alias loop R5;
loop = 0;
while(loop < 16) do
    [((userAreaPage + 1) * 512) - 16 + loop] = -1;

    loop = loop + 1;
endwhile;

//State and Inode
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 4] = RUNNING;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 7] = inodeEntry;

//Setting Library Pages
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

//Heap
[PTBR + 4] = -1;
[PTBR + 5] = "0000";
[PTBR + 6] = -1;
[PTBR + 7] = "0000";

//set arguments and save reg
multipush(R0, R1, R2, R3, R4, R5);

//Stack
R1 = GET_FREE_PAGE;
R2 = [SYSTEM_STATUS_TABLE + 1];
call MOD_2;
[PTBR + 16] = R0;
[PTBR + 17] = "0110";
call MOD_2;
[PTBR + 18] = R0;
[PTBR + 19] = "0110";

//Code
R1 = GET_CODE_PAGE;
R2 = [SYSTEM_STATUS_TABLE + 1];
R3 = [INODE_TABLE + inodeEntry * 16 + 8];
call MOD_2;
// Setting First Page
loop = 8;
[PTBR + loop] = R0;
[PTBR + loop + 1] = "0100";

loop = loop + 2;
while(loop < 16) do
    [PTBR + loop] = -1;
    [PTBR + loop + 1] = "0000";

    loop = loop + 2;
endwhile;

multipop(R0, R1, R2, R3, R4, R5);

//Disk Map Table
loop = 0;
while(loop < 10) do
    [DISK_MAP_TABLE + [SYSTEM_STATUS_TABLE + 1] * 10 + loop] = -1;
    
    loop = loop + 1;
endwhile;

loop = 0;
while(loop < 4) do
    [DISK_MAP_TABLE + [SYSTEM_STATUS_TABLE + 1] * 10 + 4 + loop] = [INODE_TABLE + inodeEntry * 16 + 8 + loop];

    loop = loop + 1;
endwhile;

//Setting entry point in user stack
[[PTBR + 16] * 512] = [[PTBR + 8] * 512 + 1];

//Changing SP to user stack
SP = 8 * 512;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

ireturn;