alias returnVal R0;
alias functionNum R1;
alias currentPID R2;


if(functionNum == ACQUIRE_DISK) then    
    while([DISK_STATUS_TABLE + 0] == 1) do
        [PROCESS_TABLE + currentPID * 16 + 4] = WAIT_DISK;

        multipush(R1, R2);

        // Calling Scheduler to run other Processes
        call MOD_5;

        multipop(R1, R2);
    endwhile;

    [DISK_STATUS_TABLE + 0] = 1;
    [DISK_STATUS_TABLE + 4] = currentPID;

    return; 
endif;

if(functionNum == ACQUIRE_SEMAPHORE) then
    alias loop R0;
    loop = 0;
    while(loop < MAX_SEM_COUNT) do
        if([SEMAPHORE_TABLE + loop * 4 + 2] == 0) then
            break;
        endif;
    endwhile;
    if(loop == MAX_SEM_COUNT) then
        loop = -1;

        return;
    endif;

    [SEMAPHORE_TABLE + loop * 4 + 0] = -1;
    [SEMAPHORE_TABLE + loop * 4 + 1] = 1;

    return;
endif;

if(functionNum == RELEASE_SEMAPHORE) then
    alias semDesc R3;

    if([SEMAPHORE_TABLE + semDesc * 4 + 0] != -1) then
        [SEMAPHORE_TABLE + semDesc * 4 + 0] = -1;

        alias processLoop R4;
        processLoop = 0;
        while(processLoop < MAX_PROC_NUM) do
            if([PROCESS_TABLE + processLoop * 16 + 4] == WAIT_SEMAPHORE && [PROCESS_TABLE + processLoop * 16 + 5] == semDesc) then
                [PROCESS_TABLE + processLoop * 16 + 4] == READY;
            endif;

            processLoop = processLoop + 1;
        endwhile;
    endif;

    [SEMAPHORE_TABLE + semDesc * 4 + 1] = [SEMAPHORE_TABLE + semDesc * 4 + 1] - 1;
endif;

if( functionNum == ACQUIRE_TERMINAL ) then
    alias terminalPID R3;

    while([TERMINAL_STATUS_TABLE + 0] == 1) do
        [PROCESS_TABLE + currentPID*16 + 4] = WAIT_TERMINAL;
        multipush(R1, R2);

        // Calling Scheduler to run other Processes
        call MOD_5;

        multipop(R1, R2);
    endwhile;

    [TERMINAL_STATUS_TABLE + 0] = 1;
    [TERMINAL_STATUS_TABLE + 1] = currentPID;
    return;
endif;

if( functionNum == RELEASE_TERMINAL ) then
    alias terminalPID R3;

    terminalPID = [TERMINAL_STATUS_TABLE + 1];
    if(currentPID != terminalPID) then
        returnVal = -1;
        return;
    endif;

    [TERMINAL_STATUS_TABLE + 0] = 0;

    alias processLoop R3;
    processLoop = 1;
    while( processLoop < MAX_PROC_NUM ) do
        if([PROCESS_TABLE + processLoop*16 + 4] ==  WAIT_TERMINAL && [PROCESS_TABLE + processLoop*16 +1] > 0) then
            [PROCESS_TABLE + processLoop*16 + 4] = READY;
        endif;

        processLoop = processLoop + 1;
    endwhile;

    returnVal = 0;
    return;
endif;