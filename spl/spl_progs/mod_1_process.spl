alias functionNum R1;

if(functionNum == GET_PCB_ENTRY) then
    alias processLoop R0;
    processLoop = 0;
    while(processLoop < MAX_PROC_NUM) do
        if([PROCESS_TABLE + processLoop * 16 + 4] == TERMINATED) then
            [PROCESS_TABLE + processLoop * 16 + 1] = processLoop;
            [PROCESS_TABLE + processLoop * 16 + 4] = ALLOCATED;
            [PROCESS_TABLE + processLoop * 16 + 14] = PAGE_TABLE_BASE + processLoop * 20;
            [PROCESS_TABLE + processLoop * 16 + 15] = 10;

            return;
        endif;

        processLoop = processLoop + 1;
    endwhile;

    R0 = -1;
    return;
endif;

if(functionNum == FREE_USER_AREA_PAGE) then
    alias currentPID R2;
    alias userAreaPage R3;
    userAreaPage = [PROCESS_TABLE + currentPID * 16 + 11];

    multipush(R1, R2, R3);

    R1 = RELEASE_PAGE;
    R2 = userAreaPage;
    call MOD_2;

    multipop(R1, R2, R3);

    // Semaphore
    alias perProcessTable R4;
    perProcessTable = ((userAreaPage + 1) * 512) - 16;
    
    alias loop R5;
    loop = 0;
    while(loop < 16) do
        if([perProcessTable + loop + 0] == SEMAPHORE) then
            multipush(R1, R2, R3, R4, R5);

            R1 = RELEASE_SEMAPHORE;
            R3 = loop;

            multipop(R1, R2, R3, R4, R5);
        endif;

        loop = loop + 2;
    endwhile;

    return;
endif;

if(functionNum == EXIT_PROCESS) then
    alias currentPID R2;
    multipush(R1, R2);
    
    R1 = FREE_PAGE_TABLE;
    R2 = currentPID;
    call MOD_1;

    R1 = FREE_USER_AREA_PAGE;
    R2 = currentPID;
    call MOD_1;

    multipop(R1, R2);

    // Set the state as terminated
    [PROCESS_TABLE + currentPID * 16 + 4] = TERMINATED;

    
    // Setting the child process
    if([PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] != 9) then
        alias processLoop R3;
        processLoop = 0;
        while(processLoop < MAX_PROC_NUM) do
            if([PROCESS_TABLE + processLoop * 16 + 4] == WAIT_PROCESS && [PROCESS_TABLE + processLoop * 16 + 5] == currentPID) then
                [PROCESS_TABLE + processLoop * 16 + 4] = READY;
            endif;

            if([PROCESS_TABLE + processLoop * 16 + 2] == currentPID) then
                [PROCESS_TABLE + processLoop * 16 + 2] = -1;
            endif;

            processLoop = processLoop + 1;
        endwhile;
    endif;

    return;
endif;

if(functionNum == FREE_PAGE_TABLE) then
    alias currentPID R2;
    alias loop R3;
    loop = 0;

    // Library
    while(loop < 4) do
        [PTBR + loop] = -1;
        [PTBR + loop + 1] = "0000";

        loop = loop + 2;
    endwhile;
    
    // Other Entries
    while(loop < 20) do
        multipush(R1, R2, R3);
        
        R1 = RELEASE_PAGE;
        R2 = [PTBR + loop];
        call MOD_2;

        multipop(R1, R2, R3);

        [PTBR + loop] = -1;
        [PTBR + loop + 1] = "0000";

        loop = loop + 2;
    endwhile;

    // Disk Map
    loop = 2;
    while(loop < 4) do
        if([DISK_MAP_TABLE + currentPID * 10 + loop] != -1) then
            multipush(R1, R2, R3);
        
            R1 = RELEASE_BLOCK;
            R2 = [DISK_MAP_TABLE + currentPID * 10 + loop];
            call MOD_2;

            multipop(R1, R2, R3);
        endif;

        loop = loop + 1;
    endwhile;

    loop = 8;
    while(loop < 10) do
        if([DISK_MAP_TABLE + currentPID * 10 + loop] != -1) then
            multipush(R1, R2, R3);
        
            R1 = RELEASE_BLOCK;
            R2 = [DISK_MAP_TABLE + currentPID * 10 + loop];
            call MOD_2;

            multipop(R1, R2, R3);
        endif;

        loop = loop + 1;
    endwhile;

    loop = 0;
    while(loop < 10) do
        [DISK_MAP_TABLE + currentPID * 10 + loop] = -1;

        loop = loop + 1;
    endwhile;

    return;
endif;