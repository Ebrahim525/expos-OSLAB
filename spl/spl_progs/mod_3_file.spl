alias functionNum R1;

if(functionNum == BUFFERED_READ) then
    alias diskBlock R2;
    alias offset R3;
    alias word R4;
    alias buffer R5;

    buffer = diskBlock % MAX_BUFFER;

    multipush(R1, R2, R3, R4, R5);

    R1 = ACQUIRE_BUFFER;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    R3 = buffer;
    call MOD_0;

    multipop(R1, R2, R3, R4, R5);

    if([BUFFER_TABLE + buffer * 4 + 0] != diskBlock) then
        if([BUFFER_TABLE + buffer * 4 + 1] == 1) then
            multipush(R1, R2, R3, R4, R5);

            R1 = DISK_STORE;
            R2 = [SYSTEM_STATUS_TABLE + 1];
            R3 = BUFFER / 512 + buffer;
            R4 = [BUFFER_TABLE + buffer * 4 + 0];
            call MOD_4;

            multipop(R1, R2, R3, R4, R5);

            [BUFFER_TABLE + buffer * 4 + 1] = 0;
        endif;

        multipush(R1, R2, R3, R4, R5);

        R1 = DISK_LOAD;
        R2 = [SYSTEM_STATUS_TABLE + 1];
        R3 = BUFFER / 512 + buffer;
        R4 = diskBlock;
        call MOD_4;

        multipop(R1, R2, R3, R4, R5);

        [BUFFER_TABLE + buffer * 4 + 0] = diskBlock;
    endif;

    [word] = [BUFFER + buffer * 512 + offset];

    multipush(R1, R2, R3, R4, R5);

    R1 = RELEASE_BUFFER;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    R3 = buffer;
    call MOD_0;

    multipop(R1, R2, R3, R4, R5);

    R0 = 0;
    return;
endif;

if(functionNum == OPEN) then
    alias file R2;
    alias inodeEntry R3;
    inodeEntry = 0;
    while(inodeEntry < MAX_FILE_NUM) do
        if([INODE_TABLE + inodeEntry * 16 + 1] == file) then
            break;
        endif;

        inodeEntry = inodeEntry + 1;
    endwhile;
    if(inodeEntry == MAX_FILE_NUM || [INODE_TABLE + inodeEntry * 16] == EXEC) then
        R0 = -1;
        
        return;
    endif;

    multipush(R1, R2, R3);

    R1 = ACQUIRE_INODE;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    R3 = inodeEntry;
    call MOD_0;

    multipop(R1, R2, R3);

    if(R0 != 0) then
        R0 = -1;
        return;
    endif;

    alias openFileEntry R4;
    openFileEntry = 0;
    while(openFileEntry < MAX_OPENFILE_NUM) do
        if([OPEN_FILE_TABLE + openFileEntry * 4 + 0] == -1) then
            break;
        endif;

        openFileEntry = openFileEntry + 1;
    endwhile;
    if(openFileEntry == MAX_OPENFILE_NUM) then
        multipush(R1, R2, R3);

        R1 = RELEASE_INODE;
        R2 = [SYSTEM_STATUS_TABLE + 1];
        R3 = inodeEntry;
        call MOD_0;

        multipop(R1, R2, R3);

        R0 = -2;
        return;
    endif;

    if(file == "root") then
        [OPEN_FILE_TABLE + openFileEntry * 4 + 0] = INODE_ROOT;
    else
        [OPEN_FILE_TABLE + openFileEntry * 4 + 0] = inodeEntry;
        if([FILE_STATUS_TABLE + inodeEntry * 4 + 1] == -1) then
            [FILE_STATUS_TABLE + inodeEntry * 4 + 1] = 1;
        else
            [FILE_STATUS_TABLE + inodeEntry * 4 + 1] = [FILE_STATUS_TABLE + inodeEntry * 4 + 1] + 1;
        endif;
    endif;

    [OPEN_FILE_TABLE + openFileEntry * 4 + 1] = 1;
    [OPEN_FILE_TABLE + openFileEntry * 4 + 2] = 0;

    multipush(R1, R2, R3, R4);

        R1 = RELEASE_INODE;
        R2 = [SYSTEM_STATUS_TABLE + 1];
        R3 = inodeEntry;
        call MOD_0;

    multipop(R1, R2, R3, R4);

    R0 = openFileEntry;

    return;
endif;

if(functionNum == CLOSE) then
    alias file R2;
    [OPEN_FILE_TABLE + file * 4 + 1] = [OPEN_FILE_TABLE + file * 4 + 1] - 1;

    if([OPEN_FILE_TABLE + file * 4 + 1] == 0) then
        if([OPEN_FILE_TABLE + file * 4 + 0] != INODE_ROOT) then
            [FILE_STATUS_TABLE + [OPEN_FILE_TABLE + file * 4 + 0] * 4 + 1] = [FILE_STATUS_TABLE + [OPEN_FILE_TABLE + file * 4 + 0] * 4 + 1] - 1;
        endif;
        if([FILE_STATUS_TABLE + [OPEN_FILE_TABLE + file * 4 + 0] * 4 + 1] == 0) then
            [FILE_STATUS_TABLE + [OPEN_FILE_TABLE + file * 4 + 0] * 4 + 1] = -1;
        endif;

        [OPEN_FILE_TABLE + file * 4 + 0] = -1;
        [OPEN_FILE_TABLE + file * 4 + 1] = -1;
        [OPEN_FILE_TABLE + file * 4 + 2] = -1;
        [OPEN_FILE_TABLE + file * 4 + 3] = -1;
    endif;

    return;
endif;