alias functionNum R1;
alias currentPID R2;
alias word R3;

if( functionNum == TERMINAL_WRITE ) then
    // Acquire Terminal
    multipush(R1, R2, R3);
    functionNum = ACQUIRE_TERMINAL;
    currentPID = R2;
    call MOD_0;
    multipop(R1, R2, R3);

    print(word);

    //Release Terminal
    multipush(R1, R2, R3);
    functionNum = RELEASE_TERMINAL;
    currentPID = R2;
    call MOD_0;
    multipop(R1, R2, R3);
    return;
endif;

if( functionNum == TERMINAL_READ) then
    // Acquire Terminal
    multipush(R1, R2, R3);
    functionNum = ACQUIRE_TERMINAL;
    currentPID = R2;
    call MOD_0;
    multipop(R1, R2, R3);

    read;

    //Change state of current process to wait

    multipush(R1, R2, R3);
    call MOD_5;
    multipop(R1, R2, R3);

    alias physicalAddr R4;
    physicalAddr = ([PTBR + R3 / 512] * 512) + (R3 % 512);
    physicalAddr = [Processes + currentPID * 16 + 8];
    return;
endif;

return;