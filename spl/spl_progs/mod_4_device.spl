alias functionNum R1;
alias currentPID R2;

if(functionNum == DISK_LOAD) then
    alias pageNumber R3;
    alias blockNumber R4;

    multipush(R1, R2, R3, R4);

    R1 = ACQUIRE_DISK;
    R2 = currentPID;
    call MOD_0;

    multipop(R1, R2, R3, R4);

    [DISK_STATUS_TABLE + 1] = 0;
    [DISK_STATUS_TABLE + 2] = pageNumber;
    [DISK_STATUS_TABLE + 3] = blockNumber;

    load(pageNumber, blockNumber);

    [PROCESS_TABLE + currentPID * 16 + 4] = WAIT_DISK;

    multipush(R1, R2, R3, R4);
    call MOD_5;
    multipop(R1, R2, R3, R4);

    return;
endif;

if( functionNum == TERMINAL_WRITE ) then
    alias word R3;

    // Acquire Terminal
    multipush(R1, R2, R3);
    functionNum = ACQUIRE_TERMINAL;
    currentPID = R2;
    call MOD_0;
    multipop(R1, R2, R3);

    print(word);

    //Release Terminal
    multipush(R1, R2, R3);
    functionNum = RELEASE_TERMINAL;
    currentPID = R2;
    call MOD_0;
    multipop(R1, R2, R3);
    return;
endif;

if( functionNum == TERMINAL_READ) then
    alias word R3;

    // Acquire Terminal
    multipush(R1, R2, R3);
    functionNum = ACQUIRE_TERMINAL;
    call MOD_0;
    multipop(R1, R2, R3);

    read;

    //Change state of current process to wait
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 4] = WAIT_TERMINAL;

    multipush(R1, R2, R3);
    call MOD_5;
    multipop(R1, R2, R3);
    
    [([PTBR + 2 * (word / 512)] * 512) + (word % 512)] = [PROCESS_TABLE + currentPID * 16 + 8];
    return;
endif;

return;