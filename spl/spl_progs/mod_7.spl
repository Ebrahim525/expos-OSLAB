// Exception Handler
loadi(2, 15);
loadi(3, 16);

// Timer Interrupt
loadi(4, 17);
loadi(5, 18);

// INT 7
loadi(16, 29);
loadi(17, 30);

// INT 10
loadi(22,35);
loadi(23,36);

// Module 0 (Terminal Acquire and Release)
loadi(40, 53);
loadi(41, 54);

// Module 4 (Terminal Write)
loadi(48, 61);
loadi(49, 62);

// Modue 5 (Scheduler)
loadi(50,63);
loadi(51,64);

// Loading Shared Library
loadi(63,13);
loadi(64,14);


// Terminal Status Table
[TERMINAL_STATUS_TABLE + 0] = 0;

// INIT Process
// Loading INIT Code
loadi(65,7);
loadi(66,8);

PTBR = PAGE_TABLE_BASE + 20;

// SHARED Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

// Heap
[PTBR+4] = 78;
[PTBR+5] = "0110";
[PTBR+6] = 79;
[PTBR+7] = "0110";

// Code
[PTBR+8] = 65;
[PTBR+9] = "0100";
[PTBR+10] = 66;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

// Stack
[PTBR+16] = 76;
[PTBR+17] = "0110";
[PTBR+18] = 77;
[PTBR+19] = "0110";

// Setting User Area Page Number in Process Table
[PROCESS_TABLE + 16 + 0] = 0; // TICK
[PROCESS_TABLE + 16 + 1] = 1; // PID
[PROCESS_TABLE + 16 + 4] = CREATED; // State
[PROCESS_TABLE + 16 + 11] = 80; // User Area Page
[PROCESS_TABLE + 16 + 12] = 0; // KPTR
[PROCESS_TABLE + 16 + 13] = 8*512; // UPTR
[PROCESS_TABLE + 16 + 14] = PAGE_TABLE_BASE+20; // PTBR
[PROCESS_TABLE + 16 + 15] = 10; // PTLR

// SETTING ENTRY POINT IN USER STACK
[76 * 512] = [65 * 512 + 1];


// Even Number
loadi(83, 69);

PTBR = PAGE_TABLE_BASE + 40;

// SHARED Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

// Heap
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";

// Code
[PTBR+8] = 83;
[PTBR+9] = "0100";
[PTBR+10] = -1;
[PTBR+11] = "0000";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

// Stack
[PTBR+16] = 84;
[PTBR+17] = "0110";
[PTBR+18] = 85;
[PTBR+19] = "0110";

// Setting User Area Page Number in Process Table
[PROCESS_TABLE + 32 + 0] = 0; // TICK
[PROCESS_TABLE + 32 + 1] = 2; // PID
[PROCESS_TABLE + 32 + 4] = CREATED; // State
[PROCESS_TABLE + 32 + 11] = 86; // User Area Page
[PROCESS_TABLE + 32 + 12] = 0; // KPTR
[PROCESS_TABLE + 32 + 13] = 8*512; // UPTR
[PROCESS_TABLE + 32 + 14] = PAGE_TABLE_BASE+40; // PTBR
[PROCESS_TABLE + 32 + 15] = 10; // PTLR

// SETTING ENTRY POINT IN USER STACK
[84 * 512] = [65 * 512 + 1];


//Setting State of other processes TERMINATED
alias processLoop R0;
processLoop = 3;

while( processLoop < MAX_PROC_NUM ) do
    [PROCESS_TABLE + processLoop*16 + 4] = TERMINATED;

    processLoop = processLoop + 1;
endwhile;

return;