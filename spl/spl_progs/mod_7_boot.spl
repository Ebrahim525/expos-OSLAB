// Exception Handler
loadi(2, 15);
loadi(3, 16);

// Timer Interrupt
loadi(4, 17);
loadi(5, 18);

// Disk Interrupt
loadi(6, 19);
loadi(7, 20);

// Console Interrupt
loadi(8, 21);
loadi(9, 22);

// INT 4 (Create, Delete)
loadi(10, 23);
loadi(11, 24);

// INT 5 (Open, Close)
loadi(12, 25);
loadi(13, 26);

// INT 6 (Read)
loadi(14, 27);
loadi(15, 28);

// INT 7 (Write)
loadi(16, 29);
loadi(17, 30);

// INT 8 (Fork)
loadi(18, 31);
loadi(19, 32);

// INT 9 (Exec)
loadi(20, 33);
loadi(21, 34);

// INT 10 (Exit)
loadi(22,35);
loadi(23,36);

// INT 11 (Wait, Signal, GetPID, GetPPID)
loadi(24,37);
loadi(25,38);

// INT 12 (Logout)
loadi(26,39);
loadi(27,40);

// INT 13 (Shutdown)
loadi(28,41);
loadi(29,42);

// INT 14 (SemLock)
loadi(30,43);
loadi(31,44);

// INT 15 (Shutdown)
loadi(32,45);
loadi(33,46);

// INT 16 (User)
loadi(34,47);
loadi(35,48);

// INT 17 (Login)
loadi(36,49);
loadi(37,50);

// Module 0 (Terminal Acquire and Release)
loadi(40, 53);
loadi(41, 54);

// Module 1 (Process)
loadi(42, 55);
loadi(43, 56);

// Module 2 (Memory)
loadi(44, 57);
loadi(45, 58);

// Module 3 (File)
loadi(46, 59);
loadi(47, 60);

// Module 4 (Terminal Write)
loadi(48, 61);
loadi(49, 62);

// Modue 5 (Scheduler)
loadi(50,63);
loadi(51,64);

// Loading Shared Library
loadi(63,13);
loadi(64,14);

// Inode Table and User Table
loadi(59, 3);
loadi(60, 4);

// Root File
loadi(62, 5);

// Disk Free List
loadi(61, 2);


// INIT Process
// Loading INIT Code
loadi(65,7);

PTBR = PAGE_TABLE_BASE + 20;

// SHARED Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

// Heap
[PTBR+4] = -1;
[PTBR+5] = "0110";
[PTBR+6] = -1;
[PTBR+7] = "0110";

// Code
[PTBR+8] = 65;
[PTBR+9] = "0100";
[PTBR+10] = -1;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

// Stack
[PTBR+16] = 66;
[PTBR+17] = "0110";
[PTBR+18] = -1;
[PTBR+19] = "0110";

// Setting User Area Page Number in Process Table
[PROCESS_TABLE + 16 + 0] = 0; // TICK
[PROCESS_TABLE + 16 + 1] = 1; // PID
[PROCESS_TABLE + 16 + 3] = KERNEL; // UserID
[PROCESS_TABLE + 16 + 4] = CREATED; // State
[PROCESS_TABLE + 16 + 11] = 77; // User Area Page
[PROCESS_TABLE + 16 + 12] = 0; // KPTR
[PROCESS_TABLE + 16 + 13] = 8*512; // UPTR
[PROCESS_TABLE + 16 + 14] = PAGE_TABLE_BASE+20; // PTBR
[PROCESS_TABLE + 16 + 15] = 10; // PTLR

// SETTING ENTRY POINT IN USER STACK
[66 * 512] = [65 * 512 + 1];

// Per Process table for Init Process
alias loop R0;
loop = 0;
while(loop < 16) do
    [(77 * 512) - 16 + loop] = -1;

    loop = loop + 1;
endwhile;

// Disk Map Entry;
loop = 0;
while(loop < 10) do
    [DISK_MAP_TABLE + 10 + loop] = -1;
    
    loop = loop + 1;
endwhile;

[DISK_MAP_TABLE + 10 + 4] = 7;


// Shell
loadi(67, 9);
loadi(68, 10);
// SHARED Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

// Heap
[PTBR+4] = -1;
[PTBR+5] = "0110";
[PTBR+6] = -1;
[PTBR+7] = "0110";

// Code
[PTBR+8] = 67;
[PTBR+9] = "0100";
[PTBR+10] = 68;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

// Stack
[PTBR+16] = 78;
[PTBR+17] = "0110";
[PTBR+18] = 79;
[PTBR+19] = "0110";

// Setting User Area Page Number in Process Table
[PROCESS_TABLE + 32 + 0] = 0; // TICK
[PROCESS_TABLE + 32 + 1] = 2; // PID
[PROCESS_TABLE + 32 + 2] = 1; // PPID
[PROCESS_TABLE + 32 + 4] = TERMINATED; // State
[PROCESS_TABLE + 32 + 11] = 80; // User Area Page
[PROCESS_TABLE + 32 + 12] = 0; // KPTR
[PROCESS_TABLE + 32 + 13] = 8*512; // UPTR
[PROCESS_TABLE + 32 + 14] = PAGE_TABLE_BASE+40; // PTBR
[PROCESS_TABLE + 32 + 15] = 10; // PTLR

// SETTING ENTRY POINT IN USER STACK
[78 * 512] = [67 * 512 + 1];

// Per Process table for Init Process
loop = 0;
while(loop < 16) do
    [(80 * 512) - 16 + loop] = -1;

    loop = loop + 1;
endwhile;


// Disk Map Entry;
loop = 0;
while(loop < 10) do
    [DISK_MAP_TABLE + 20 + loop] = -1;
    
    loop = loop + 1;
endwhile;

[DISK_MAP_TABLE + 20 + 4] = 9;
[DISK_MAP_TABLE + 20 + 5] = 10;


//Setting State of other processes TERMINATED
alias processLoop R0;
processLoop = 3;
while( processLoop < MAX_PROC_NUM ) do
    [PROCESS_TABLE + processLoop*16 + 4] = TERMINATED;

    processLoop = processLoop + 1;
endwhile;


//Memory Free List
alias memLoop R0;
memLoop = 0;
while(memLoop < 81) do
    [MEMORY_FREE_LIST + memLoop] = 1;

    memLoop = memLoop + 1;
endwhile;

while(memLoop < NUM_MEM_PAGES) do
    [MEMORY_FREE_LIST + memLoop] = 0;

    memLoop = memLoop + 1;
endwhile;

// Semaphore
alias semaLoop R0;
semaLoop = 0;
while(semaLoop < MAX_SEM_COUNT) do
    [SEMAPHORE_TABLE + semaLoop * 4 + 0] = -1;
    [SEMAPHORE_TABLE + semaLoop * 4 + 1] = 0;
     semaLoop = semaLoop + 1;
endwhile;


// System Status Table
// Wait Mem Count
[SYSTEM_STATUS_TABLE + 3] = 0;
// Mem Free Count
[SYSTEM_STATUS_TABLE + 2] = 47;


// Terminal Status Table
[TERMINAL_STATUS_TABLE + 0] = 0;


// Disk Status Table
[DISK_STATUS_TABLE + 0] = 0;

// File Status Table
alias loop R0;
loop = 0;
while(loop < MAX_FILE_NUM) do
    [FILE_STATUS_TABLE + loop * 4 + 0] = -1;
    [FILE_STATUS_TABLE + loop * 4 + 1] = -1;

    loop = loop + 1;
endwhile;

// Buffer Table
loop = 0;
while(loop < MAX_BUFFER) do
    [BUFFER_TABLE + loop * 4 + 0] = -1;
    [BUFFER_TABLE + loop * 4 + 1] = 0;
    [BUFFER_TABLE + loop * 4 + 2] = -1;

    loop = loop + 1;
endwhile;

// Open File Table
loop = 0;
while(loop < MAX_OPENFILE_NUM) do
    [OPEN_FILE_TABLE + loop * 4 + 0] = -1;
    [OPEN_FILE_TABLE + loop * 4 + 1] = 0;

    loop = loop + 1;
endwhile;

return;