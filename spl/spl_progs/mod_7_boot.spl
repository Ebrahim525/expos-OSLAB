alias loop2 R0;
loop2 = 2;
while(loop2 < 38) do
    loadi(loop2, loop2 + 13);

    loop2 = loop2 + 1;
endwhile;

loop2 = 40;
while(loop2 < 54) do
    loadi(loop2, loop2 + 13);

    loop2 = loop2 + 1;
endwhile;



// Loading Shared Library
loadi(63,13);
loadi(64,14);

// Inode Table and User Table
loadi(59, 3);
loadi(60, 4);

// Root File
loadi(62, 5);

// Disk Free List
loadi(61, 2);


// INIT Process
// Loading INIT Code
loadi(65,7);

PTBR = PAGE_TABLE_BASE + 20;

// SHARED Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

// Heap
[PTBR+4] = -1;
[PTBR+5] = "0110";
[PTBR+6] = -1;
[PTBR+7] = "0110";

// Code
[PTBR+8] = 65;
[PTBR+9] = "0100";
[PTBR+10] = -1;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

// Stack
[PTBR+16] = 66;
[PTBR+17] = "0110";
[PTBR+18] = -1;
[PTBR+19] = "0110";

alias processTable R1;
processTable = PROCESS_TABLE + 16;
// Setting User Area Page Number in Process Table
[processTable + 0] = 0; // TICK
[processTable + 1] = 1; // PID
[processTable + 3] = KERNEL; // UserID
[processTable + 4] = CREATED; // State
[processTable + 11] = 77; // User Area Page
[processTable + 12] = 0; // KPTR
[processTable + 13] = 8*512; // UPTR
[processTable + 14] = PAGE_TABLE_BASE+20; // PTBR
[processTable + 15] = 10; // PTLR

// SETTING ENTRY POINT IN USER STACK
[66 * 512] = [65 * 512 + 1];




// Shell
PTBR = PAGE_TABLE_BASE + 40;
loadi(67, 9);
loadi(68, 10);
// SHARED Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

// Heap
[PTBR+4] = -1;
[PTBR+5] = "0110";
[PTBR+6] = -1;
[PTBR+7] = "0110";

// Code
[PTBR+8] = 67;
[PTBR+9] = "0100";
[PTBR+10] = 68;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

// Stack
[PTBR+16] = 78;
[PTBR+17] = "0110";
[PTBR+18] = 79;
[PTBR+19] = "0110";

processTable = PROCESS_TABLE + 32;
// Setting User Area Page Number in Process Table
[processTable + 0] = 0; // TICK
[processTable + 1] = 2; // PID
[processTable + 2] = 1; // PPID
[processTable + 4] = TERMINATED; // State
[processTable + 11] = 80; // User Area Page
[processTable + 12] = 0; // KPTR
[processTable + 13] = 8*512; // UPTR
[processTable + 14] = PAGE_TABLE_BASE+40; // PTBR
[processTable + 15] = 10; // PTLR

// SETTING ENTRY POINT IN USER STACK
[78 * 512] = [67 * 512 + 1];





// Per Process table for Init Process
alias loop R0;
loop = 0;
while(loop < 16) do
    [(77 * 512) - 16 + loop] = -1;
    [(80 * 512) - 16 + loop] = -1;

    loop = loop + 1;
endwhile;


// Disk Map Entry;
loop = 0;
while(loop < 10) do
    [DISK_MAP_TABLE + 10 + loop] = -1;
    [DISK_MAP_TABLE + 20 + loop] = -1;
    
    loop = loop + 1;
endwhile;
// Init
[DISK_MAP_TABLE + 10 + 4] = 7;
// Shell
[DISK_MAP_TABLE + 20 + 4] = 9;
[DISK_MAP_TABLE + 20 + 5] = 10;



//Setting State of other processes TERMINATED
alias processLoop R0;
processLoop = 0;
while( processLoop < MAX_PROC_NUM ) do
    [PROCESS_TABLE + processLoop * 16 + 0] = 0; // TICK

    if(processLoop > 2 && processLoop != 15) then
        [PROCESS_TABLE + processLoop * 16 + 4] = TERMINATED;
    endif;

    processLoop = processLoop + 1;
endwhile;


//Memory Free List
alias memLoop R0;
memLoop = 0;
while(memLoop < 83) do
    [MEMORY_FREE_LIST + memLoop] = 1;

    memLoop = memLoop + 1;
endwhile;

while(memLoop < NUM_MEM_PAGES) do
    [MEMORY_FREE_LIST + memLoop] = 0;

    memLoop = memLoop + 1;
endwhile;
[MEMORY_FREE_LIST + 69] = 2;

// Semaphore
alias semaLoop R0;
semaLoop = 0;
while(semaLoop < MAX_SEM_COUNT) do
    [SEMAPHORE_TABLE + semaLoop * 4 + 0] = -1;
    [SEMAPHORE_TABLE + semaLoop * 4 + 1] = 0;
     semaLoop = semaLoop + 1;
endwhile;


// System Status Table
[SYSTEM_STATUS_TABLE + 2] = 45; // Mem Free Count
[SYSTEM_STATUS_TABLE + 3] = 0; // Wait Mem Count
[SYSTEM_STATUS_TABLE + 4] = 0; // Swap Count
[SYSTEM_STATUS_TABLE + 5] = 0; // Paging Status


// Terminal Status Table
[TERMINAL_STATUS_TABLE + 0] = 0;


// Disk Status Table
[DISK_STATUS_TABLE + 0] = 0;

// File Status Table
alias loop R0;
loop = 0;
while(loop < MAX_FILE_NUM) do
    [FILE_STATUS_TABLE + loop * 4 + 0] = -1;
    [FILE_STATUS_TABLE + loop * 4 + 1] = -1;

    loop = loop + 1;
endwhile;

// Buffer Table
loop = 0;
while(loop < MAX_BUFFER) do
    [BUFFER_TABLE + loop * 4 + 0] = -1;
    [BUFFER_TABLE + loop * 4 + 1] = 0;
    [BUFFER_TABLE + loop * 4 + 2] = -1;

    loop = loop + 1;
endwhile;

// Open File Table
loop = 0;
while(loop < MAX_OPENFILE_NUM) do
    [OPEN_FILE_TABLE + loop * 4 + 0] = -1;
    [OPEN_FILE_TABLE + loop * 4 + 1] = 0;

    loop = loop + 1;
endwhile;

return;