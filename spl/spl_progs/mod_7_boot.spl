// Exception Handler
loadi(2, 15);
loadi(3, 16);

// Timer Interrupt
loadi(4, 17);
loadi(5, 18);

// Disk Interrupt
loadi(6, 19);
loadi(7, 20);

// Console Interrupt
loadi(8, 21);
loadi(9, 22);

// INT 6 (Read)
loadi(14, 27);
loadi(15, 28);

// INT 7 (Write)
loadi(16, 29);
loadi(17, 30);

// INT 9 (Exec)
loadi(20, 33);
loadi(21, 34);

// INT 10 (After execution)
loadi(22,35);
loadi(23,36);

// Module 0 (Terminal Acquire and Release)
loadi(40, 53);
loadi(41, 54);

// Module 1 (Process)
loadi(42, 55);
loadi(43, 56);

// Module 2 (Memory)
loadi(44, 57);
loadi(45, 58);

// Module 4 (Terminal Write)
loadi(48, 61);
loadi(49, 62);

// Modue 5 (Scheduler)
loadi(50,63);
loadi(51,64);

// Loading Shared Library
loadi(63,13);
loadi(64,14);

// Inode Table and User Table
loadi(59, 3);
loadi(60, 4);

// Disk Free List
loadi(61, 2);


// INIT Process
// Loading INIT Code
loadi(65,7);
loadi(66,8);

PTBR = PAGE_TABLE_BASE + 20;

// SHARED Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

// Heap
[PTBR+4] = 78;
[PTBR+5] = "0110";
[PTBR+6] = 79;
[PTBR+7] = "0110";

// Code
[PTBR+8] = 65;
[PTBR+9] = "0100";
[PTBR+10] = 66;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

// Stack
[PTBR+16] = 76;
[PTBR+17] = "0110";
[PTBR+18] = 77;
[PTBR+19] = "0110";

// Setting User Area Page Number in Process Table
[PROCESS_TABLE + 16 + 0] = 0; // TICK
[PROCESS_TABLE + 16 + 1] = 1; // PID
[PROCESS_TABLE + 16 + 4] = CREATED; // State
[PROCESS_TABLE + 16 + 11] = 80; // User Area Page
[PROCESS_TABLE + 16 + 12] = 0; // KPTR
[PROCESS_TABLE + 16 + 13] = 8*512; // UPTR
[PROCESS_TABLE + 16 + 14] = PAGE_TABLE_BASE+20; // PTBR
[PROCESS_TABLE + 16 + 15] = 10; // PTLR

// SETTING ENTRY POINT IN USER STACK
[76 * 512] = [65 * 512 + 1];

// Per Process table for Init Process
alias loop R0;
loop = 0;
while(loop < 16) do
    [(81 * 512) - 16 + loop] = -1;

    loop = loop + 1;
endwhile;

// Disk Map Entry;
loop = 0;
while(loop < 10) do
    [DISK_MAP_TABLE + [SYSTEM_STATUS_TABLE + 1] * 10 + loop] = -1;
    
    loop = loop + 1;
endwhile;

[DISK_MAP_TABLE + [SYSTEM_STATUS_TABLE + 1] * 10 + 4] = 65;
[DISK_MAP_TABLE + [SYSTEM_STATUS_TABLE + 1] * 10 + 5] = 66;


//Setting State of other processes TERMINATED
alias processLoop R0;
processLoop = 2;
while( processLoop < MAX_PROC_NUM ) do
    [PROCESS_TABLE + processLoop*16 + 4] = TERMINATED;

    processLoop = processLoop + 1;
endwhile;


//Memory Free List
alias memLoop R0;
memLoop = 0;
while(memLoop < 83) do
    [MEMORY_FREE_LIST + memLoop] = 1;

    memLoop = memLoop + 1;
endwhile;

while(memLoop < NUM_MEM_PAGES) do
    [MEMORY_FREE_LIST + memLoop] = 0;

    memLoop = memLoop + 1;
endwhile;


// System Status Table
// Wait Mem Count
[SYSTEM_STATUS_TABLE + 3] = 0;
// Mem Free Count
[SYSTEM_STATUS_TABLE + 2] = 45;


// Terminal Status Table
[TERMINAL_STATUS_TABLE + 0] = 0;


// Disk Status Table
[DISK_STATUS_TABLE + 0] = 0;

return;