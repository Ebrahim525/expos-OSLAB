PTLR = 10;

// Module 7 (Boot)
loadi(54, 67);
loadi(55, 68);

// Loading Idle Code
loadi(69, 11);

SP = 76 * 512 - 1;

call BOOT_MODULE;


// Idle Process
PTBR = PAGE_TABLE_BASE;

// Library
[PTBR+0] = -1;
[PTBR+1] = "0000";
[PTBR+2] = -1;
[PTBR+3] = "0000";

// Heap
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";

// Code
[PTBR+8] = 69;
[PTBR+9] = "0100";
[PTBR+10] = -1;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

// Stack
[PTBR+16] = 70;
[PTBR+17] = "0110";
[PTBR+18] = -1;
[PTBR+19] = "0000";

// Setting User Area Page Number in Process Table
[PROCESS_TABLE + 0] = 0; // TICK
[PROCESS_TABLE + 1] = 0; // PID
[PROCESS_TABLE + 3] = 0; // USERID
[PROCESS_TABLE + 4] = RUNNING; // STATE
[PROCESS_TABLE + 11] = 76; // User Area Page
[PROCESS_TABLE + 12] = 0; // KPTR
[PROCESS_TABLE + 13] = 8*512; // UPTR
[PROCESS_TABLE + 14] = PAGE_TABLE_BASE; // PTBR
[PROCESS_TABLE + 15] = 10; // PTLR

//SETTING ENTRY POINT IN USER STACK
[70 * 512] = [69 * 512 + 1];


// SWAPPER DAEMON
PTBR = PAGE_TABLE_BASE + 300;

// Library
[PTBR+0] = -1;
[PTBR+1] = "0000";
[PTBR+2] = -1;
[PTBR+3] = "0000";

// Heap
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";

// Code
[PTBR+8] = 69;
[PTBR+9] = "0100";
[PTBR+10] = -1;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

// Stack
[PTBR+16] = 81;
[PTBR+17] = "0110";
[PTBR+18] = -1;
[PTBR+19] = "0000";

// Setting User Area Page Number in Process Table
[PROCESS_TABLE + 240 + 0] = 0; // TICK
[PROCESS_TABLE + 240 + 1] = 0; // PID
[PROCESS_TABLE + 240 + 3] = 0; // USERID
[PROCESS_TABLE + 240 + 4] = CREATED; // STATE
[PROCESS_TABLE + 240 + 11] = 82; // User Area Page
[PROCESS_TABLE + 240 + 12] = 0; // KPTR
[PROCESS_TABLE + 240 + 13] = 8*512; // UPTR
[PROCESS_TABLE + 240 + 14] = PAGE_TABLE_BASE + 300; // PTBR
[PROCESS_TABLE + 240 + 15] = 10; // PTLR
[81 * 512] = [69 * 512 + 1];



alias loop R0;
loop = 0;
while(loop < 10) do
    [DISK_MAP_TABLE + loop] = -1;
    [DISK_MAP_TABLE + 150 + loop] = -1;
    
    loop = loop + 1;
endwhile;

[DISK_MAP_TABLE + 4] = 11;
[DISK_MAP_TABLE + 150 + 4] = 11;


PTBR = PAGE_TABLE_BASE;
// Setting PID Number in System Status Table
[SYSTEM_STATUS_TABLE + 1] = 0;

// Setting SP to point to the user stack of Idle Process
SP = 8 * 512;

ireturn;