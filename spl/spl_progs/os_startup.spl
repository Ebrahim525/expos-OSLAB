PTLR = 10;

// Module 7 (Boot)
loadi(54, 67);
loadi(55, 68);

// Loading Idle Code
loadi(69, 11);
loadi(70, 12);

SP = 82 * 512 - 1;

call BOOT_MODULE;

// Idle Process
PTBR = PAGE_TABLE_BASE;

// Library
[PTBR+0] = -1;
[PTBR+1] = "0000";
[PTBR+2] = -1;
[PTBR+3] = "0000";

// Heap
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";

// Code
[PTBR+8] = 69;
[PTBR+9] = "0100";
[PTBR+10] = 70;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

// Stack
[PTBR+16] = 81;
[PTBR+17] = "0110";
[PTBR+18] = -1;
[PTBR+19] = "0000";

// Setting User Area Page Number in Process Table
[PROCESS_TABLE + 0] = 0; // TICK
[PROCESS_TABLE + 1] = 0; // PID
[PROCESS_TABLE + 4] = RUNNING; // STATE
[PROCESS_TABLE + 11] = 82; // User Area Page
[PROCESS_TABLE + 12] = 0; // KPTR
[PROCESS_TABLE + 13] = 8*512; // UPTR
[PROCESS_TABLE + 14] = PAGE_TABLE_BASE; // PTBR
[PROCESS_TABLE + 15] = 10; // PTLR

[DISK_MAP_TABLE + 10] = 11;
[DISK_MAP_TABLE + 10] = 12;

// Setting PID Number in System Status Table
[SYSTEM_STATUS_TABLE + 1] = 0;

//SETTING ENTRY POINT IN USER STACK
[81 * 512] = [69 * 512 + 1];

// Setting SP to point to the user stack of Idle Process
SP = 8 * 512;

ireturn;